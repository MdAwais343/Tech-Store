# Copy to .env.local for local development, and add the same two variables in Vercel
# (Project -> Settings -> Environment Variables). Leave them out to run in browser-only demo mode.
# Both values: Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
